# Configurações e credenciais sensíveis
[Cc]onfig.py
auth.json
**/state_context/*.json

# Cache Python
__pycache__/
*.py[cod]
*$py.class

# Logs
logs/
*.log

# Planilhas exportadas do SAP (dados financeiros - Confidencial Interno)
arquivos_extraidos/

# Pastas de arquivos removidos / backup
_removido/
removido/

# Virtual Environments
venv/

# Pasta de correlacao SAP-NG (dados financeiros - Confidencial Interno)
*.xlsb

# Cache das tabelas mestras e planilhas de saida (derivados dos dados acima).
# O manifesto fica versionado: da rastreabilidade sem expor os dados.
dados_mestres/*
!dados_mestres/manifesto.json
saidas/
